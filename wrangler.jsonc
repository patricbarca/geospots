// GeoSpots: Worker + D1 "geospots" + R2 "geospots-files". Plan gratis de Workers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geospots",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // La app (PWA) se sirve como asset; /api/* pasa por el Worker.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "geospots", "database_id": "5d7a1c2e-0b1f-4c4e-9a51-3f0c2b7d9e10", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "geospots-files" }
  ],
  "vars": { "APP_VERSION": "0.2.0" },
  "observability": { "enabled": true }
}
